# Server
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DB_NAME?retryWrites=true&w=majority

# Auth
JWT_SECRET=generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:5173

# Email (optional — if not set, emails are logged to console)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Kera High School <no-reply@keraschool.et>"
